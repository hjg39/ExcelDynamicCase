--- !u!114 &795930427
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 795930424}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: acd99916876a6405980838d7635b65cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  items:
  - id: 1.0
    text: I, King of the Masters division, formally challenge you to a battle!
    image: {fileID: 0}
    audio: {fileID: 0}
    quest: {fileID: 0}
    options:
    - text: How could I refuse?
      image: {fileID: 0}
      audio: {fileID: 0}
      targetId: 1.1
      enabled: 0
    - text: What can I earn?
      image: {fileID: 0}
      audio: {fileID: 0}
      targetId: 1.2
      enabled: 0
    - text: Maybe in a bit Harry...
      image: {fileID: 0}
      audio: {fileID: 0}
      targetId: 1.3
      enabled: 0
    unlockedFunction: 
    tag: 
    rewardClassification: 0
  - id: 1.1
    text: BATTLE
