      propertyPath: items.Array.data[0].options.Array.data[0].text
      value: I never thought that at all... those were tough!
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[0].options.Array.data[1].text
