    image: {fileID: 0}
    audio: {fileID: 0}
    quest: {fileID: 0}
    options: []
    unlockedFunction: 
    tag: 
    rewardClassification: 0
  - id: 1.3
    text: Don't make me wait until you're also in the Master's division.
    image: {fileID: 0}
    audio: {fileID: 0}
    quest: {fileID: 0}
    options: []
    unlockedFunction: 
    tag: 
    rewardClassification: 0
