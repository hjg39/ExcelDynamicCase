      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[4].id
      value: 3.0
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[0].text
      value: Hey Dim!  I've drunk way too much today...
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[1].text
      value: Alice?  No, not quite...
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[2].text
      value: This is an in-development area where you can solve curated custom challenges!
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[3].text
      value: You'll find out at the FMWC UK finals... but be warned, you will never
        be the same again afterward...
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[4].text
      value: Not yet, but check back soon!
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[0].options.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[1].options.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[2].options.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[0].options.Array.data[0].text
      value: I recognise you!  Are you called Alice?
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[0].options.Array.data[1].text
      value: What is this place?
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[1].options.Array.data[0].text
      value: Oh sorry, what then?
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[2].options.Array.data[0].text
      value: Oh do you have a curated challenge for me?
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
