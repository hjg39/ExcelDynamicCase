  m_Name: 
  m_EditorClassIdentifier: 
  items:
  - id: 1.0
    text: Before I destroy you later, I thought I'd be nice and give you some useful
      functions.
    image: {fileID: 0}
    audio: {fileID: 0}
    quest: {fileID: 0}
    options:
    - text: Will the Rand functions ever help?
      image: {fileID: 0}
      audio: {fileID: 0}
      targetId: 1.1
      enabled: 0
    unlockedFunction: RAND RANDBETWEEN RANDARRAY
    tag: UpdateHarrySeidersConversation
    rewardClassification: 0
  - id: 1.1
    text: You're welcome!
    image: {fileID: 0}
    audio: {fileID: 0}
    quest: {fileID: 0}
    options: []
    unlockedFunction: 
    tag: UpdateHarrySeidersConversation
    rewardClassification: 0
