    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[2].id
      value: 2.1
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[3].id
      value: 2.2
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[4].id
      value: 2.3
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[0].text
      value: I am Michael Jarman - the reigning Excel World Champion.
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[1].text
      value: And so you should be.  Beware, I set the hardest challenges in the game!
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[2].text
      value: BATTLE
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[3].text
      value: REWARD
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[4].text
      value: Take your time, my son.
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[0].options.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[1].options.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[0].options.Array.data[0].text
      value: I'm starstruck!
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[0].options.Array.data[1].text
      value: I kinda love it!
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[1].options.Array.data[0].text
      value: Let's see them!
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[1].options.Array.data[1].text
