    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[0].text
      value: People used to think I was nice and friendly when I made Battle Royale
        and Bear Island!
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[1].text
      value: It's all part of the learning process!
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
      propertyPath: items.Array.data[2].text
      value: Don't speak too soon - I've got a whopper on the horizon!
      objectReference: {fileID: 0}
    - target: {fileID: 353955888, guid: 74b5c6b26f0fc4028b9aac1a7a36767d, type: 3}
